# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit it.

APP_NAME="SDC App"
APP_URL=http://localhost/sdc-project/public
# Local development values. On the production host (Railway) set
# APP_ENV=production and APP_DEBUG=false: debug mode prints internal error
# details to visitors.
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sdc_app
DB_USER=root
DB_PASS=

AI_SERVICE_URL=http://127.0.0.1:5000
AI_TIMEOUT=15

# --- Encryption (API key storage) -------------------------------------------
# 32-byte key, base64-encoded. Generate one with:
#   php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# --- Google OAuth (optional) -------------------------------------------------
# NOT read from this file. Both values are stored in the database and set by an
# administrator on the Key page (?page=key), encrypted at rest. They are listed
# here only so the variable names are documented; the entries below are ignored
# by config.php.
#
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# add this Authorised redirect URI (NO query string - Google rejects those):
#   http://localhost/sdc-project/public/auth/google-callback
# Until both are set on the Key page the Google button is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OneSignal push (optional) -----------------------------------------------
# Also database-only (Key page). The App ID is public and is injected into every
# page for a signed-in user as a <meta>; the REST API key is a SECRET and stays
# server-side. Until both are set the bell and push switch are hidden.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
