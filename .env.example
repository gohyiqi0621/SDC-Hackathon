# Copy this file to .env (local) or add these to Replit / hosting secrets.
# Never commit your real .env file.

APP_NAME="Smart SME"
# Leave empty to derive the URL from the request. Pin it when the app lives in
# a XAMPP subdirectory (the email dashboard then shares the same base URL).
APP_URL=http://localhost/SDC-Hackathon/public
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur

# --- PostgreSQL (required; the app has no MySQL driver path) ---------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sme_assistant
DB_USER=yiqi
DB_PASS=change-me
DB_SSLMODE=prefer

# --- Sessions --------------------------------------------------------------
SESSION_NAME=sme_session
SESSION_IDLE_MINUTES=30
SESSION_LIFETIME_MINUTES=480

# --- Password rule ---------------------------------------------------------
PASSWORD_MIN_LENGTH=8

# --- Brevo transactional email --------------------------------------------
# Used for password-reset links and the test send on the email dashboard.
# BREVO_SENDER_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Smart SME"
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# --- TLS (Windows) ---------------------------------------------------------
# PHP on Windows ships without a CA store. Point this at XAMPP's bundle if
# outgoing HTTPS fails with "unable to get local issuer certificate".
MAIL_CA_BUNDLE=C:/xampp/apache/bin/curl-ca-bundle.crt

# --- Gmail inbox on the dashboard (Google OAuth, read-only) ---------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Add GMAIL_REDIRECT_URI to "Authorized redirect URIs" exactly as written.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost/SDC-Hackathon/public/gmail/callback
GMAIL_MAX_RESULTS=20

# --- Existing project variables -------------------------------------------
PROJECT_NAME="Smart SME"
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id

# --- AI Settings & Integration --------------------------------------------
# Encrypts the Telegram bot token and Google tokens stored in PostgreSQL.
# Create it once with:  C:\xampp\php\php.exe bin\generate-key.php
# Changing it later makes stored tokens unreadable (users reconnect).
APP_ENCRYPTION_KEY=

# Google Calendar (OAuth "Web application" client from Google Cloud Console,
# with the Google Calendar API enabled). Authorized redirect URI:
#   http://localhost/SDC-Hackathon/public/ai_settings/google_calendar_oauth_callback
# (it is APP_URL + /ai_settings/google_calendar_oauth_callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only if the redirect URI must differ from the default above.
GOOGLE_REDIRECT_URI=

# --- Telegram -> website -> Flowise (AI replies) ---------------------------
# Public https address of this app, for the Telegram webhook and for Flowise
# tools calling back. On XAMPP use a tunnel, e.g.
#   ngrok http 80   ->   https://abc123.ngrok-free.app/SDC-Hackathon/public
# After changing it, run:  C:\xampp\php\php.exe bin\telegram-webhook.php
PUBLIC_APP_URL=

# Flowise Prediction API (see docs/FLOWISE.md).
FLOWISE_API_URL=
FLOWISE_CHATFLOW_ID=
# Optional: separate chatflows per provider (otherwise FLOWISE_CHATFLOW_ID).
FLOWISE_CHATFLOW_ID_ANTHROPIC=
FLOWISE_CHATFLOW_ID_DEEPSEEK=
# Flowise API key for the chatflow (Flowise > API Keys), if it is protected.
FLOWISE_API_KEY=
FLOWISE_TIMEOUT=90
# Send each business's own AI provider key to Flowise in vars.provider_api_key.
# Set to false if the keys are stored as credentials inside Flowise instead.
FLOWISE_SEND_PROVIDER_KEY=true
