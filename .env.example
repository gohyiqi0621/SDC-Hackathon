# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit it.
#
# Fastest path: from the project root run
#     php setup.php
# which writes .env for you, generates APP_KEY and checks the DB connection.
# (Hand-editing this file works too - just copy it to .env first.)

APP_NAME="SDC App"

# Base URL. Leave BLANK and it is derived from the incoming request, which is
# what makes the app work unchanged on localhost, behind a tunnel, and on
# Railway. Pin it only when the app must always emit one canonical origin.
#   Local  : (blank)
#   Railway: https://your-app.up.railway.app
APP_URL=

# 'production' on a server, anything else locally.
# This is NOT cosmetic: push subscriptions are namespaced by it (production uses
# sdc-user-<id>, everywhere else sdc-dev-user-<id>) so a device that subscribed
# on localhost can never be picked as a production recipient. Deploying with
# APP_ENV=local would leave the live app targeting nobody.
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sdc_app
DB_USER=root
DB_PASS=

# Where the Python AI service lives.
#   Local  : http://127.0.0.1:5000  (cd ai-service && python app.py)
#   Railway: http://sdc-ai.railway.internal:5000  -- the private network name,
#            NOT a public URL. The service has no public domain on purpose.
AI_SERVICE_URL=http://127.0.0.1:5000
AI_TIMEOUT=15

# --- Encryption (API key storage) -------------------------------------------
# 32-byte key, base64-encoded. Generate one with:
#   php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# --- Google OAuth (optional) -------------------------------------------------
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# add this Authorised redirect URI (NO query string - Google rejects those):
#   http://localhost/sdc-project/public/auth/google-callback
#
# The client id and secret are NOT read from this file: they live in the
# `settings` table and are managed on the admin Key page (the secret is sealed
# with AES-256-GCM). Leave the button hidden by leaving them blank there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OneSignal push (optional) -----------------------------------------------
# Also configured on the admin Key page, not here - an empty value in .env does
# nothing. The App ID is public and injected into every signed-in page; the REST
# API key is a SECRET and never leaves the server.
#
# One OneSignal app is shared by every environment, so production must run with
# APP_ENV=production (above) or its devices are treated as dev devices.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
