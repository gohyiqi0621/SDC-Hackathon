# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit it.

APP_NAME="SDC App"
APP_URL=http://localhost/sdc-project/public
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sdc_app
DB_USER=root
DB_PASS=

AI_SERVICE_URL=http://127.0.0.1:5000
AI_TIMEOUT=15

# --- Encryption (API key storage) -------------------------------------------
# 32-byte key, base64-encoded. Generate one with:
#   php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# --- Google OAuth (optional) -------------------------------------------------
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# add this Authorised redirect URI (NO query string - Google rejects those):
#   http://localhost/sdc-project/public/auth/google-callback
# Leave blank to hide/disable the "Sign in with Google" button.
#
# Both values can also be set at runtime from the admin Key page, which takes
# precedence over .env. DB values are managed there; .env is the fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OneSignal push (optional) -----------------------------------------------
# App ID is public and is injected into every page for the admin as a <meta>.
# The REST API key is a SECRET: set it from the admin Key page (encrypted at
# rest) rather than here. Leave both blank to hide the bell and push switch.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
