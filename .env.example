# Copy this file to .env (local) or add these to Replit / hosting secrets.
# Never commit your real .env file.

APP_NAME="SME Smart"
# Leave empty to derive the URL from the request. Pin it when the app lives in
# a XAMPP subdirectory (the email dashboard then shares the same base URL).
APP_URL=http://localhost/SDC-Hackathon/public
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur

# --- PostgreSQL (required; the app has no MySQL driver path) ---------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_SSLMODE=prefer

# --- Sessions --------------------------------------------------------------
SESSION_NAME=sme_session
SESSION_IDLE_MINUTES=60
SESSION_LIFETIME_MINUTES=480

# --- Password rule ---------------------------------------------------------
PASSWORD_MIN_LENGTH=8

# --- Brevo transactional email --------------------------------------------
# Used for password-reset links and the test send on the email dashboard.
# BREVO_SENDER_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME="SME Smart"
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# --- TLS (Windows) ---------------------------------------------------------
# PHP on Windows ships without a CA store. Point this at XAMPP's bundle if
# outgoing HTTPS fails with "unable to get local issuer certificate".
MAIL_CA_BUNDLE=C:/xampp/apache/bin/curl-ca-bundle.crt

# --- Gmail inbox on the dashboard (Google OAuth, read-only) ---------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Add GMAIL_REDIRECT_URI to "Authorized redirect URIs" exactly as written.
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost/SDC-Hackathon/public/gmail/callback
GMAIL_MAX_RESULTS=20

# --- Existing project variables -------------------------------------------
PROJECT_NAME="Smart SME"

# --- AI writing (not the chatbots): "Generate instruction with AI" on the
# Setup pages, and the email summary / reply draft on the dashboard.
# Tried in order: RunPod -> Claude (ANTHROPIC_API_KEY) -> Agnes (AGNES_API_KEY).
# On Replit put these in Secrets.
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-runpod-endpoint-id

# --- AI Settings & Integration --------------------------------------------
# Encrypts the Telegram bot token and Google tokens stored in PostgreSQL.
# Create it once with:  C:\xampp\php\php.exe bin\generate-key.php
# Changing it later makes stored tokens unreadable (users reconnect).
APP_ENCRYPTION_KEY=

# Google Calendar (OAuth "Web application" client from Google Cloud Console,
# with the Google Calendar API enabled). Authorized redirect URI:
#   http://localhost/SDC-Hackathon/public/ai_settings/google_calendar_oauth_callback
# (it is APP_URL + /ai_settings/google_calendar_oauth_callback)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: only if the redirect URI must differ from the default above.
GOOGLE_REDIRECT_URI=

# --- Telegram -> website -> Flowise (AI replies) ---------------------------
# Public https address of this app, for the Telegram webhook and for Flowise
# tools calling back. On XAMPP use a tunnel, e.g.
#   ngrok http 80   ->   https://abc123.ngrok-free.app/SDC-Hackathon/public
# After changing it, run:  C:\xampp\php\php.exe bin\telegram-webhook.php
PUBLIC_APP_URL=https://your-app.replit.app

# Flowise Prediction API (see docs/FLOWISE.md).
FLOWISE_API_URL=https://your-flowise-host
FLOWISE_CHATFLOW_ID=your-customer-chatflow-id
FLOWISE_STAFF_CHATFLOW_ID=your-staff-chatflow-id
# Optional: separate chatflows per provider (otherwise the two above).
# Claude models (ChatAnthropic node, key sent as overrideConfig.anthropicApiKey):
FLOWISE_CHATFLOW_ID_ANTHROPIC=your-customer-chatflow-id-for-claude
FLOWISE_STAFF_CHATFLOW_ID_ANTHROPIC=your-staff-chatflow-id-for-claude
# Others use ChatOpenAI-style nodes (key sent as overrideConfig.openAIApiKey):
FLOWISE_CHATFLOW_ID_DEEPSEEK=
# Flowise API key for the chatflow (Flowise > API Keys), if it is protected.
FLOWISE_API_KEY=your-flowise-api-key
FLOWISE_TIMEOUT=90
# Send each business's own AI provider key to Flowise in vars.provider_api_key.
# Set to false if the keys are stored as credentials inside Flowise instead.
FLOWISE_SEND_PROVIDER_KEY=true

# --- Agnes AI: "Generate SOPs with AI" on AI Settings ----------------------
# OpenAI-style API. Without AGNES_API_KEY the business's own saved key is used
# when its assistant runs on Agnes 2.5 Flash.
AGNES_API_KEY=your-agnes-api-key
# Claude key: AI writing fallback after RunPod, and AI auto-fill of invoices / receipts.
ANTHROPIC_API_KEY=your-anthropic-api-key
AGNES_API_URL=https://apihub.agnes-ai.com/v1
AGNES_SOP_MODEL=agnes-2.5-flash

# --- Optional: remove the "# " to use one (defaults apply otherwise) -----
# Sessions are kept in PostgreSQL so Replit autoscale does not log people out.
# Set to "files" to use PHP's own session files instead.
# SESSION_STORE=database
# Flow Log page (?page=system&action=logs): who may open it.
# LOG_VIEWER_EMAILS=you@example.com
# LOG_VIEW_KEY=your-long-random-log-key
# Which provider the plain FLOWISE_CHATFLOW_ID / FLOWISE_STAFF_CHATFLOW_ID belong to.
# FLOWISE_DEFAULT_PROVIDER=Agnes
# AI writing models / RunPod address.
# TEXT_AI_CLAUDE_MODEL=claude-haiku-4-5
# AGNES_MODEL=agnes-2.5-flash
# RUNPOD_API_URL=https://api.runpod.ai/v2
# Google Search Console ownership tag for the live site.
# GOOGLE_SITE_VERIFICATION=your-google-site-verification-code
