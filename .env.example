# Copy this file to .env (local) or add these to Replit / hosting secrets.
# Never commit your real .env file.

APP_NAME="Smart SME"
# Leave empty to derive the URL from the request. Pin it when the app lives in
# a XAMPP subdirectory (the email dashboard then shares the same base URL).
APP_URL=http://localhost/SDC-Hackathon/public
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur

# --- PostgreSQL (required; the app has no MySQL driver path) ---------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sme_assistant
DB_USER=yiqi
DB_PASS=change-me
DB_SSLMODE=prefer

# --- Sessions --------------------------------------------------------------
SESSION_NAME=sme_session
SESSION_IDLE_MINUTES=30
SESSION_LIFETIME_MINUTES=480

# --- Password rule ---------------------------------------------------------
PASSWORD_MIN_LENGTH=8

# --- Brevo transactional email --------------------------------------------
# Used for password-reset links and the test send on the email dashboard.
# BREVO_SENDER_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Smart SME"
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# --- TLS (Windows) ---------------------------------------------------------
# PHP on Windows ships without a CA store. Point this at XAMPP's bundle if
# outgoing HTTPS fails with "unable to get local issuer certificate".
MAIL_CA_BUNDLE=C:/xampp/apache/bin/curl-ca-bundle.crt

# --- Existing project variables -------------------------------------------
PROJECT_NAME="Smart SME"
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id
