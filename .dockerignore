# Applies to BOTH Railway builds (PHP app at the repo root, and the AI service
# selected via RAILWAY_DOCKERFILE_PATH=ai-service/Dockerfile). The build context
# is the repository root in both cases.

.git/
.gitignore
README-RECONCILIATION.md

# Python leftovers - never useful inside a container.
**/__pycache__/
*.py[cod]
ai-service/.venv/
ai-service/venv/
.pytest_cache/
.mypy_cache/
