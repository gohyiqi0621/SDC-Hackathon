# public/uploads/.htaccess - user-uploaded images only.
# Nothing in here may ever run as code, and folders are never listed.
Options -Indexes

<FilesMatch "(?i)\.(php\d*|phtml|phar|pl|py|cgi|sh|shtml|asp|aspx|jsp|htaccess)$">
    Require all denied
</FilesMatch>

<IfModule php_module>
    php_flag engine off
</IfModule>
